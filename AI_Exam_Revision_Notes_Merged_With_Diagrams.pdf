BT 1 0 0 1 0 96 Tm /F5+0 7.4 Tf 9.4 TL (function backtrack;) Tj T* (  SL := [Start]; NSL := [Start]; DE := []; CS := Start;) Tj T* (  while NSL \010 [] do) Tj T* (    if CS = goal then return SL;) Tj T* (    if CS has no children \(excluding nodes on DE, SL, NSL\) then) Tj T* (        while SL not empty and CS = first\(SL\) do) Tj T* (            add CS to DE; remove first\(SL\); remove first\(NSL\); CS := first\(NSL\);) Tj T* (        add CS to SL) Tj T* (    else  place children of CS \(not on DE, SL, NSL\) on NSL;) Tj T* (          CS := first\(NSL\); add CS to SL) Tj T* (  return FAIL) Tj T* ET
